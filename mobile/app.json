{
  "expo": {
    "name": "OffPay",
    "slug": "offpay",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "offpay",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.offpay.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#07090E",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "package": "com.offpay.mobile",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/offpay-mark.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#07090E",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
